<Project>

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- All non-MAUI projects target net10.0 -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'MealPlanner.UI.Mobile'">
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Microsoft .NET 10 runtime packages (all ship at the same patch) -->
    <!-- EF Core providers converge with the main group in .NET 10 -->
    <MicrosoftEFCore>10.0.13</MicrosoftEFCore>
    <MicrosoftEFCoreSqlServer>10.0.13</MicrosoftEFCoreSqlServer>
    <MicrosoftEFCoreSqlite>10.0.13</MicrosoftEFCoreSqlite>
    <MicrosoftEFCoreInMemory>10.0.13</MicrosoftEFCoreInMemory>
    <MicrosoftEFCoreDesign>10.0.13</MicrosoftEFCoreDesign>
    <!-- Other Microsoft packages -->
    <MicrosoftAspNetCoreAuthenticationJwtBearer>10.0.13</MicrosoftAspNetCoreAuthenticationJwtBearer>
    <MicrosoftAspNetCoreComponents>10.0.13</MicrosoftAspNetCoreComponents>
    <MicrosoftAspNetCoreComponentsWebAssemblyAuthentication>10.0.13</MicrosoftAspNetCoreComponentsWebAssemblyAuthentication>
    <MicrosoftAspNetCoreDiagnosticsEntityFrameworkCore>10.0.13</MicrosoftAspNetCoreDiagnosticsEntityFrameworkCore>
    <MicrosoftAspNetCoreIdentityEntityFrameworkCore>10.0.13</MicrosoftAspNetCoreIdentityEntityFrameworkCore>
    <MicrosoftAspNetCoreIdentityUI>10.0.13</MicrosoftAspNetCoreIdentityUI>
    <MicrosoftAspNetCoreSignalRClient>10.0.13</MicrosoftAspNetCoreSignalRClient>
    <MicrosoftDataSqlClient>7.1.1</MicrosoftDataSqlClient>
    <MicrosoftDataSqlite>10.0.13</MicrosoftDataSqlite>
    <MicrosoftExtensionsCachingMemory>10.0.13</MicrosoftExtensionsCachingMemory>
    <MicrosoftExtensionsConfigurationAbstractions>10.0.13</MicrosoftExtensionsConfigurationAbstractions>
    <MicrosoftExtensionsConfigurationJson>10.0.13</MicrosoftExtensionsConfigurationJson>
    <MicrosoftExtensionsDependencyInjection>10.0.13</MicrosoftExtensionsDependencyInjection>
    <MicrosoftExtensionsHttp>10.0.13</MicrosoftExtensionsHttp>
    <MicrosoftExtensionsLoggingAbstractions>10.0.13</MicrosoftExtensionsLoggingAbstractions>
    <MicrosoftExtensionsLoggingDebug>10.0.13</MicrosoftExtensionsLoggingDebug>
    <!-- Transitive override: Microsoft.IdentityModel pulls a vulnerable System.Security.Cryptography.Pkcs by default -->
    <SystemSecurityCryptographyPkcs>10.0.13</SystemSecurityCryptographyPkcs>
    <!-- MAUI (ships on a separate cadence) -->
    <MicrosoftMaui>10.0.110</MicrosoftMaui>
    <CommunityToolkitMvvm>8.4.2</CommunityToolkitMvvm>
    <CommunityToolkitMaui>15.0.1</CommunityToolkitMaui>
    <!-- Test infrastructure -->
    <MicrosoftNETTestSdk>18.11.0</MicrosoftNETTestSdk>
    <NUnitVersion>5.0.0</NUnitVersion>
    <NUnitAnalyzers>4.15.0</NUnitAnalyzers>
    <NUnit3TestAdapter>6.3.1</NUnit3TestAdapter>
    <CoverletCollector>10.1.0</CoverletCollector>
    <!-- Third-party -->
    <AngleSharp>1.8.5</AngleSharp>
    <AutoMapper>16.1.1</AutoMapper>
    <BlazorBootstrap>4.0.0</BlazorBootstrap>
    <BlazorExpressChartJS>1.2.4</BlazorExpressChartJS>
    <BlazoredLocalStorage>4.5.0</BlazoredLocalStorage>
    <BlazoredModal>7.3.1</BlazoredModal>
    <BlazoredSessionStorage>2.4.0</BlazoredSessionStorage>
    <BootstrapDialog>3.3.4.1</BootstrapDialog>
    <BUnit>2.12.5</BUnit>
    <DuendeIdentityServer>8.0.10</DuendeIdentityServer>
    <DuendeIdentityServerAspNetIdentity>8.0.10</DuendeIdentityServerAspNetIdentity>
    <FluentValidation>12.2.0</FluentValidation>
    <MediatR>12.5.0</MediatR>
    <Moq>4.21.0</Moq>
    <MudBlazor>9.11.0</MudBlazor>
    <NewtonsoftJson>13.0.4</NewtonsoftJson>
    <RichardSzalayMockHttp>7.1.0</RichardSzalayMockHttp>
    <Serilog>4.4.0</Serilog>
    <SerilogAspNetCore>10.0.0</SerilogAspNetCore>
    <SerilogSinksMSSqlServer>10.0.0</SerilogSinksMSSqlServer>
    <SkiaSharp>4.153.1</SkiaSharp>
    <SwashbuckleAspNetCore>10.3.1</SwashbuckleAspNetCore>
  </PropertyGroup>

</Project>
