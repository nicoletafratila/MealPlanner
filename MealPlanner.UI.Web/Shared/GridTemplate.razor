@typeparam TItem

<style>
    .table-empty tbody tr td {
        border-bottom-style: none !important;
        border-bottom-color: transparent !important;
        justify-content: center !important;
    }

    .table-empty th:nth-child(1),
    .table-empty td:nth-child(1) {
        width: 40px;
        max-width: 40px;
    }

    .table-grid {
        display: flex;
        flex-wrap: wrap;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        width: 100%;
        height: 100%;
        border-color: white;
        max-height: 100%;
        margin-bottom: 10px;
    }

        .table-grid > tbody {
            display: flex;
            justify-content: flex-start;
            align-items: flex-start;
            flex-wrap: wrap;
            width: 100%;
            height: 100%;
        }

    .table-grid--center > tbody {
        justify-content: center;
        align-items: center;
        border-color: white;
    }

    .table-grid > thead {
        display: inline-table;
        vertical-align: middle;
    }

        .table-grid > thead > tr {
            border-bottom-color: #dee2e6;
            border-bottom-width: 0px;
            width: inherit;
        }

            .table-grid > thead > tr > th {
                width: 50%;
            }

    .table-grid > :not(caption) > * > * {
        padding: 0.3rem 0.3rem !important;
        background-color: white !important;
        color: black;
        width: inherit;
    }

    .table > thead {
        width: inherit;
    }
</style>

@if (Caption != null)
{
    <div class="caption-top grid-caption">
        @Caption
    </div>
}

<Grid TItem="TItem"
      @ref="gridTemplateReference"
      AllowFiltering="true"
      AllowSorting="true"
      AllowPaging="@AllowPaging"
      AutoHidePaging="true"
      Class="@(!string.IsNullOrEmpty(TableGridClass) ? TableGridClass : "")"
      DataProvider="DataProviderWrapperAsync"
      SettingsProvider="SettingsProviderWrapperAsync"
      PageSize="@PageSize"
      PageSizeSelectorVisible="true"
      PageSizeSelectorItems="@PageSizeSelectorItems"
      Responsive="true"
      FiltersRowCssClass="bg-primary text-white bg-opacity-25"
      HeaderRowCssClass="@HeaderRowCssClass">

    @if (Columns != null)
    {
        @Columns
    }

    <GridTemplates>
        <GridEmptyDataTemplate TItem="TItem">
            <div class="d-flex justify-content-center align-items-center">
                <img src="Images/empty-state.svg" width="128" height="128" alt="" />
            </div>
        </GridEmptyDataTemplate>
    </GridTemplates>
</Grid>