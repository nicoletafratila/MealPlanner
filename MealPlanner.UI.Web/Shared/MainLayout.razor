@using MealPlanner.UI.Web.Pages.Identities
@using MudBlazor
@using MealPlanner.UI.Web.Shared

@inherits LayoutComponentBase

<style>
    .header-table {
        width: 100%;
    }

    .header-bottom-cell {
        padding: 0;
    }

    .header-bottom-flex {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        column-gap: 1rem;
    }

    .login-cell {
        white-space: nowrap;
    }

    .header-links-cell {
        padding: 0.5rem 0 0;
        text-align: right;
    }

    .header-links {
        display: flex;
        justify-content: flex-end;
        column-gap: 1em;
    }

    .motto-text {
        font-size: 1.1rem;
        font-weight: 500;
        text-align: left;
        width: 230px;
    }

    .current-menu-cell {
        flex: 1 1 auto;
        text-align: center;
        white-space: nowrap;
    }

    .current-menu-link {
        font-size: 0.95rem;
        font-weight: 500;
        margin: 0;
    }

    @@media (max-width: 640.98px) {
        .header-table,
        .layout-table {
            display: block;
            width: 100%;
            position: relative;
        }

        .page-share-toolbar {
            position: absolute;
            top: 0;
            right: 0.5rem;
            z-index: 2;
        }

        .layout-table > tr,
        .layout-table > tr > td {
            display: block;
            width: 100%;
        }

        .header-row-top {
            display: flex;
            align-items: center;
            column-gap: 0.5rem;
        }

            .header-row-top td {
                display: block;
                width: auto;
            }

            .header-row-top td:empty {
                display: none;
            }

        .header-bottom-flex {
            flex-direction: column;
            align-items: flex-start;
            row-gap: 0.25rem;
        }

        .header-links-cell {
            text-align: left;
            padding-top: 0;
        }

        .header-links {
            flex-wrap: wrap;
            justify-content: flex-start;
            column-gap: 0.75rem;
            row-gap: 0.25rem;
        }

        .motto-text {
            width: auto;
        }

        .login-cell,
        .header-links a,
        .current-menu-cell {
            text-align: left;
            white-space: normal;
            font-size: 0.85rem;
        }
    }
</style>

<PageTitle>@Resources.MainLayout.PageTitle</PageTitle>

<MudContainer Class="page-container">
    <MudPaper Class="banner">
        <Banner />
    </MudPaper>

    <div class="banner-container">
        <table class="header-table">
            <tr class="header-row-top">
                <td class="image-column">
                   <img src="Images\logo2.png" alt="Logo Image" class="logo-image" />
                </td>
                <td class="logo-title-cell">
                    <p class="logo-text">@Resources.MainLayout.LogoText</p>
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
            </tr>
            <tr class="header-row-bottom">
                <td colspan="6" class="header-bottom-cell">
                    <div class="header-bottom-flex">
                        <p class="motto-text">@Resources.MainLayout.Motto</p>
                        <div class="current-menu-cell">
                            @if (_currentMealPlan is not null)
                            {
                                <p class="current-menu-link">
                                    @Resources.MainLayout.CurrentMenuLabel <a href="mealplans/mealplanedit/@_currentMealPlan.Id">@_currentMealPlan.Name</a>
                                </p>
                            }
                            else if (_isAuthenticated && !_loadFailed)
                            {
                                <p class="current-menu-link">
                                    @Resources.MainLayout.NoMenuYetPrefix<a href="mealplans/mealplanedit/">@Resources.MainLayout.NoMenuYetLinkText</a>@Resources.MainLayout.NoMenuYetSuffix
                                </p>
                            }
                        </div>
                        <div class="login-cell">
                            <LoginDisplay />
                        </div>
                    </div>
                </td>
            </tr>
            <tr class="header-row-links">
                <td colspan="6" class="header-links-cell">
                    <div class="header-links">
                        <a href="contactus/">@Resources.MainLayout.ContactUs</a>
                        <a href="privacypolicy/">@Resources.MainLayout.PrivacyPolicy</a>
                        <a href="https://linkedin.com/in/claudia-nicoleta-fratila" target="_blank">@Resources.MainLayout.AboutMe</a>
                    </div>
                </td>
            </tr>
        </table>
        <hr class="custom-line">
    </div>

    <table class="w-100 h-100 layout-table">
        <tr>
            <td class="row nav-cell">
                <NavMenu />
            </td>
            <td class="main-content-cell">
                <div>
                    <main>
                        <div class="content">
                            @if (IsErrorActive)
                            {
                                <div>
                                    <Alert Color="AlertColor.Danger" Dismissable="true" OnClose="HideErrorAsync">
                                        <Icon Name="IconName.ExclamationTriangleFill" class="me-2"></Icon>
                                        @Message
                                    </Alert>
                                </div>
                            }
                            @if (IsInfoActive)
                            {
                                <div>
                                    <Alert Color="AlertColor.Success" Dismissable="true" OnClose="HideInfoAsync">
                                        <Icon Name="IconName.CheckCircleFill" class="me-2"></Icon>
                                        @Message
                                    </Alert>
                                </div>
                            }
                            <CascadingValue Value="(Func<Task>)RefreshCurrentMealPlanAsync" Name="RefreshCurrentMealPlan">
                                <CascadingValue Value="this" Name="MessageComponent">
                                    <div>
                                        <div>
                                            @Body
                                        </div>
                                    </div>
                                </CascadingValue>
                            </CascadingValue>
                        </div>
                    </main>
                </div>
            </td>
        </tr>
    </table>
</MudContainer>

<Modal IsServiceModal="true" />
<Preload />
<Toasts class="p-3" AutoHide="true" Delay="4000" Placement="ToastsPlacement.TopRight" />
