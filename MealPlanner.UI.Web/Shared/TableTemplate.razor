@using Common.Constants
@typeparam TItem

<style>
    .table > :not(caption) > * > * {
        padding: 0.3rem 0.3rem !important;
    }

    tr.no-hover-bg:hover, td.no-hover-bg:hover {
        background: none !important;
        cursor: default !important;
    }

    .table > tbody > tr > td {
        align-content: center;
        height: 42px;
    }
</style>

<table class="@(Data == null || !Data.Any() ? CssClasses.TableTemplateEmptyClass : CssClasses.TableTemplateWithItemsClass)">
    <caption>@TableCaption</caption>
    <thead>
        <tr>
            @if (EnableDragReorder)
            {
                <th class="drag-col"></th>
            }
            @if (ShowIndex)
            {
                <th class="action-col">@IndexHeaderText</th>
            }
            @TableHeader
        </tr>
    </thead>
    <tbody>
        @if (Data == null || !Data.Any())
        {
            <tr class="no-hover-bg">
                <td class="no-hover-bg empty-cell" colspan="@((ShowIndex ? ColumnCount + 1 : ColumnCount) + (EnableDragReorder ? 1 : 0))">
                    <img src="Images/empty-state.svg" class="empty-svg" width="128" height="128" alt="" />
                </td>
            </tr>
        }
        else
        {
            @foreach (var item in Data!)
            {
                <tr draggable="@(EnableDragReorder ? "true" : "false")"
                    @ondragstart="() => OnDragStart(item)"
                    @ondragover:preventDefault="EnableDragReorder"
                    @ondrop="async () => await OnDropAsync(item)"
                    @onclick="async () => await OnSelectedItemChangedAsync(item)">
                    @if (EnableDragReorder)
                    {
                        <td class="drag-handle"><i class="bi bi-grip-vertical"></i></td>
                    }
                    @if (ShowIndex)
                    {
                        <td>@item.Index</td>
                    }
                    @if (RowTemplate is not null)
                    {
                        @RowTemplate(item)
                    }
                    else
                    {
                        <td></td>
                    }
                </tr>
            }
        }
    </tbody>
</table>
