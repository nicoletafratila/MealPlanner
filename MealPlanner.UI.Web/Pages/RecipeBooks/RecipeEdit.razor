@page "/recipebooks/recipeedit"
@page "/recipebooks/recipeedit/{id}"

<Breadcrumb style="--bs-breadcrumb-divider: '>';" Items="_navItems"></Breadcrumb>

<style>
    .img-recipe {
        max-width: 200px;
        max-height: 200px;
    }
</style>

@if (Recipe != null)
{
    <div class="card">
        <div class="card-header">
            <table>
                <tr class="row g-0" style="display:contents">
                    <td style="vertical-align: top">
                        <h2 id="headerName">@Recipe.Name</h2>
                    </td>
                    <td style="align-content:flex-end;">
                        <img class="img-recipe" src="@Recipe.ImageUrl" />
                    </td>
                </tr>
            </table>
        </div>

        <div class="card-body">
            <EditForm Model="@Recipe" OnValidSubmit="@SaveAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-group">
                    <label for="name" class="col-sm-3">@Resources.RecipeEdit.LabelRecipeName</label>
                    <InputText id="name" class="form-control" @bind-Value="@Recipe.Name" placeholder="@Resources.RecipeEdit.PlaceholderRecipeName" oninput="updateHeader()"></InputText>
                    <ValidationMessage For="@(() => Recipe.Name)" />
                </div>

                <div class="form-group mt-3">
                    <label for="source" class="col-sm-3">@Resources.RecipeEdit.LabelOriginalSource</label>
                    <div class="input-group">
                        <InputText id="source"
                                   class="form-control"
                                   @bind-Value="@Recipe.Source"
                                   placeholder="@Resources.RecipeEdit.PlaceholderOriginalSource" />
                        @if (!string.IsNullOrWhiteSpace(Recipe.Source))
                        {
                            <span class="input-group-text">
                                <a href="@Recipe.Source" target="_blank">
                                    <img src="Images/webIcon.png" alt="icon" class="small-icon">
                                </a>
                            </span>
                        }
                    </div>
                    <ValidationMessage For="@(() => Recipe.Source)" />
                </div>

                <div class="form-group mt-3">
                    <label for="recipeCategory" class="col-sm-3">@Resources.RecipeEdit.LabelRecipeCategory</label>
                    <ComboBox Id="recipeCategory" Items="RecipeCategories?.Items" IdSelector="c => c.Id" TextSelector="c => c.Name" @bind-Value="Recipe.RecipeCategoryId" For="@(() => Recipe.RecipeCategoryId)" />
                    <ValidationMessage For="@(() => Recipe.RecipeCategoryId)" />
                </div>

                <div class="form-group mt-3">
                    <label for="image" class="col-sm-3">@Resources.RecipeEdit.LabelSelectImage</label>
                    <ValidatedInputFile Id="image" OnChange="OnInputFileChangeAsync" Accept="image/png, image/jpeg, image/gif" For="@(() => Recipe.ImageContent)" />
                    <ValidationMessage For="@(() => Recipe.ImageContent)" />
                </div>

                <div class="form-group mt-3">
                    <label for="ingredientCategory" class="col-sm-3">@Resources.RecipeEdit.LabelIngredientCategory</label>
                    <ComboBox Id="ingredientCategory" Items="ProductCategories?.Items" IdSelector="c => c.Id.ToString()" TextSelector="c => c.Name" @bind-Value="IngredientCategoryFilterId" @bind-Value:after="() => OnProductCategoryChangedAsync(new ChangeEventArgs { Value = IngredientCategoryFilterId })" Placeholder="@Resources.RecipeEdit.AllCategoriesOption" />
                </div>

                <div class="form-group mt-3">
                    <label for="ingredient" class="col-sm-3">@Resources.RecipeEdit.LabelIngredient</label>
                    <ProductPicker Id="ingredient" Products="Products?.Items" SelectedProductId="@ProductId" Placeholder="@Resources.RecipeEdit.ChooseOption" OnChanged="OnProductChangedAsync" />
                </div>

                <div class="form-group mt-3">
                    <div class="row g-2 align-items-end">
                        <div class="col">
                            <label for="quantity">@Resources.RecipeEdit.LabelQuantity</label>
                            <InputText id="quantity" class="form-control" @bind-Value="@Quantity" @oninput="CheckQuantityAsync" placeholder="@Resources.RecipeEdit.PlaceholderQuantity"></InputText>
                            <ValidationMessage For="@(() => Quantity)" />
                        </div>
                        <div class="col">
                            <label for="unit">@Resources.RecipeEdit.LabelUnitOfMeasurement</label>
                            <ComboBox Id="unit" Items="Units" IdSelector="u => u.Id.ToString()" TextSelector="u => u.Name" @bind-Value="UnitId" For="@(() => UnitId)" />
                            <ValidationMessage For="@(() => UnitId)" />
                        </div>
                        <div class="col-auto">
                            <button id="addButton" class="btn btn-primary" type="button" @onclick="@AddIngredientAsync" disabled="@(!CanAddIngredient)">@Resources.RecipeEdit.AddButton</button>
                        </div>
                    </div>
                </div>

                <br />

                <div class="col">
                    <ValidationMessage For="@(() => Recipe.Ingredients)" />
                    <TableTemplate Data="@Recipe.Ingredients" ShowIndex="true" IndexHeaderText="" ColumnCount="6">
                        <TableCaption>@Resources.RecipeEdit.ListOfIngredients</TableCaption>
                        <TableHeader>
                            <th></th>
                            <th></th>
                            <th style="width: 40px"></th>
                        </TableHeader>
                        <RowTemplate Context="RecipeIngredient">
                            @if (RecipeIngredient != null && RecipeIngredient.Product != null)
                            {
                                <td style="vertical-align:middle">
                                    <div style="display:flex; align-items: center">
                                        <img src="@RecipeIngredient.Product.ThumbnailUrl" class="img-fluid" width="100" height="80" />
                                        <p>&nbsp;&nbsp;&nbsp;&nbsp;</p>
                                        <p>@RecipeIngredient.Product.Name</p>
                                    </div>
                                </td>
                                <td style="vertical-align:middle">
                                    <div style="display:flex; align-items: center">
                                        <p>@RecipeIngredient.Quantity</p>
                                        <p>&nbsp;&nbsp;</p>
                                        <p>@RecipeIngredient.Unit?.Name</p>
                                    </div>
                                </td>
                                <td>
                                    <button class="btn btn-link btn-sm p-0 text-danger" type="button" @onclick="() => DeleteIngredientAsync(RecipeIngredient.Product)">
                                        <i class="bi bi-trash" style="font-size: 1.25rem;"></i>
                                    </button>
                                </td>
                            }
                        </RowTemplate>
                    </TableTemplate>
                </div>

                <button type="submit" class="btn btn-primary btn-sm">@Resources.RecipeEdit.SaveButton</button>
                <button class="btn btn-danger btn-sm" type="button" @onclick="async () => await DeleteAsync()">@Resources.RecipeEdit.DeleteButton</button>
                <button class="btn btn-primary btn-sm" type="button" @onclick="NavigateToOverview">@Resources.RecipeEdit.BackToOverviewButton</button>
            </EditForm>
        </div>
    </div>
}

<ConfirmDialog @ref="_dialog" />

<script>
    function checkQuantity() {
        var quantity = document.getElementById("quantity").value;
        var unit = document.getElementById("unit").value;
        var addButton = document.getElementById("addButton");
        if (quantity > 0 && unit != "") {
            addButton.disabled = false;
        } else {
            addButton.disabled = true;
        }
    }

    function updateHeader() {
        var input = document.getElementById("name").value;
        document.getElementById("headerName").innerText = input;
    }
</script>
