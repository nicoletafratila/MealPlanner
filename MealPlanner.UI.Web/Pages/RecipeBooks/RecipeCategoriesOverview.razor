@page "/recipebooks/recipecategoriesoverview"
@using RecipeBook.Shared.Models

<Breadcrumb Items="_navItems"></Breadcrumb>

<div>
    <div class="card">
        <div class="card-header">
            <table>
                <tr>
                    <td class="w-100">
                        <h2>@Resources.RecipeCategoriesOverview.PageTitle</h2>
                    </td>
                    <td class="text-nowrap">
                        <button class="btn btn-primary btn-sm" type="button" @onclick="() => New()">@Resources.RecipeCategoriesOverview.NewButton</button>
                    </td>
                </tr>
            </table>
        </div>

        <div class="card-body">
            @if (Categories != null)
            {
                <TableTemplate TItem="RecipeCategoryModel" Data="@Categories" ShowIndex="true" ColumnCount="4" EnableDragReorder="true" OnReorder="OnReorderAsync">
                    <TableHeader>
                        <th>@Resources.RecipeCategoriesOverview.ColumnName</th>
                        <th class="action-col"></th>
                        <th class="action-col"></th>
                        <th class="action-col"></th>
                    </TableHeader>
                    <RowTemplate Context="category">
                        <td>
                            @category.Name
                        </td>
                        <td>
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="@Resources.RecipeCategoriesOverview.ReorderMenuLabel" @onclick:stopPropagation="true">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu">
                                    <li><button class="dropdown-item" type="button" disabled="@(!CanMoveUp(category))" @onclick="() => MoveUp(category)">@Resources.RecipeCategoriesOverview.MoveUpAction</button></li>
                                    <li><button class="dropdown-item" type="button" disabled="@(!CanMoveDown(category))" @onclick="() => MoveDown(category)">@Resources.RecipeCategoriesOverview.MoveDownAction</button></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><button class="dropdown-item" type="button" disabled="@(!CanMoveUp(category))" @onclick="() => MoveToTop(category)">@Resources.RecipeCategoriesOverview.MoveToTopAction</button></li>
                                    <li><button class="dropdown-item" type="button" disabled="@(!CanMoveDown(category))" @onclick="() => MoveToBottom(category)">@Resources.RecipeCategoriesOverview.MoveToBottomAction</button></li>
                                </ul>
                            </div>
                        </td>
                        <td><button class="btn btn-primary btn-sm" type="button" @onclick="() => Update(category)">@Resources.RecipeCategoriesOverview.EditButton</button></td>
                        <td>
                            <button class="btn btn-link btn-sm p-0 text-danger" type="button" @onclick="() => DeleteAsync(category)">
                                <i class="bi bi-trash fs-5"></i>
                            </button>
                        </td>
                    </RowTemplate>
                </TableTemplate>
            }
        </div>
    </div>

    <div class="col mt-3">
        <button class="btn btn-primary btn-sm" type="button" @onclick="async () => await SaveAsync()">@Resources.RecipeCategoriesOverview.SaveButton</button>
    </div>
</div>

<ConfirmDialog @ref="_dialog" />