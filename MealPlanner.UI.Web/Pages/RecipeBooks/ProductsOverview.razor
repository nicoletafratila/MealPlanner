@page "/recipebooks/productsoverview"
@using RecipeBook.Shared.Models

<Breadcrumb Items="_navItems"></Breadcrumb>

<div class="card">
    <div class="card-header">
        <table class="w-100">
            <tr>
                <td class="w-100">
                    <h2>@Resources.ProductsOverview.PageTitle</h2>
                </td>
                <td class="text-nowrap">
                    <button class="btn btn-primary btn-sm" type="button" @onclick="() => New()">@Resources.ProductsOverview.NewButton</button>
                </td>
            </tr>
        </table>
    </div>

    <div class="card-body">
        <GridTemplate TItem="ProductModel" @key="@_gridKey" @ref="_productsGrid" DataProvider="DataProviderAsync" SettingsProvider="SettingsProviderAsync" TableGridClass="@_tableGridClass" PageSize="@_pageSize" PageSizeSelectorItems="@(new int[] { 20, 40, 60, 80, 100 })">
            <Columns>
                <GridColumn TItem="ProductModel" HeaderText="@Resources.ProductsOverview.HeaderName" PropertyName="Name" SortString="Name" SortKeySelector="item => item.Name" IsDefaultSortColumn="true" SortDirection="@_nameSortDirection" StringComparison="StringComparison.OrdinalIgnoreCase">
                    <div class="card-template">
                        <div class="card-header p-0">
                            <img src="@context.ImageUrl" class="img-fluid card-cover-img" @onclick="() => Update(context)" />
                        </div>
                        <div class="card-body">
                            <table>
                                <tr>
                                    <td class="fill-space">
                                        @context.Name
                                    </td>
                                    <td class="min-space">
                                        <i class="bi bi-trash text-danger fs-5 cursor-pointer" @onclick="() => DeleteAsync(context)"></i>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fill-space">
                                        @context.ProductCategoryName
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </GridColumn>
                <GridColumn TItem="ProductModel" HeaderText="@Resources.ProductsOverview.HeaderCategory" PropertyName="ProductCategoryName" SortString="ProductCategoryName" SortKeySelector="item => item.ProductCategoryName" StringComparison="StringComparison.OrdinalIgnoreCase" />
            </Columns>
        </GridTemplate>
    </div>
</div>

<ConfirmDialog @ref="_dialog" />
