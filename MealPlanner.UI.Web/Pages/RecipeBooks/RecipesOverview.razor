@page "/"
@page "/recipebooks/recipesoverview"

@using RecipeBook.Shared.Models

<Breadcrumb Items="_navItems"></Breadcrumb>

<div class="card">
    <div class="card-header">
        <table class="w-100">
            <tr>
                <td class="w-100">
                    <h2>@Resources.RecipesOverview.PageTitle</h2>
                </td>
                <td class="text-nowrap">
                    <button class="btn btn-primary btn-sm" type="button" @onclick="() => New()">@Resources.RecipesOverview.NewButton</button>
                </td>
            </tr>
        </table>
    </div>

    <div class="card-body">
        <GridTemplate TItem="RecipeModel" @key="@_gridKey" @ref="_recipesGrid" DataProvider="DataProviderAsync" SettingsProvider="SettingsProviderAsync" TableGridClass="@_tableGridClass" PageSize="@_pageSize" PageSizeSelectorItems="@(new int[] { 20, 40, 60, 80, 100 })">
            <Columns>
                <GridColumn TItem="RecipeModel" HeaderText="@Resources.RecipesOverview.HeaderName" PropertyName="Name" SortString="Name" SortKeySelector="item => item.Name" IsDefaultSortColumn="true" SortDirection="@_nameSortDirection" StringComparison="StringComparison.OrdinalIgnoreCase">
                    <div class="card-template">
                        <div class="card-header position-relative p-0">
                            <img src="@context.ImageUrl"
                                 class="img-fluid card-cover-img"
                                 @onclick="() => Update(context)" />

                            <img src="Images/add.png"
                                 class="add-icon"
                                 @onclick="() => AddToMealPlanAsync(context)" />
                        </div>
                        <div class="card-body">
                            <table>
                                <tr>
                                    <td class="fill-space">
                                        @context.Name
                                    </td>
                                    <td class="min-space">
                                        @if (!string.IsNullOrWhiteSpace((context.Source)))
                                        {
                                            <a href="@context.Source" target="_blank">
                                                <img src="Images\webIcon.png" alt="icon" class="small-icon">
                                            </a>
                                        }
                                    </td>
                                    <td class="min-space">
                                        <i class="bi bi-trash text-danger fs-5 cursor-pointer" @onclick="() => DeleteAsync(context)"></i>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fill-space">
                                        @context.RecipeCategoryName
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </GridColumn>
                <GridColumn TItem="RecipeModel" PropertyName="RecipeCategoryName" Sortable="false" Filterable="false" StringComparison="StringComparison.OrdinalIgnoreCase">
                    <HeaderContent>
                        <div class="category-filter-header">
                            <span>@Resources.RecipesOverview.HeaderCategory</span>
                            <div class="category-filter-control">
                                <ComboBox Id="recipeCategoryFilter" Items="RecipeCategories?.Items" IdSelector="c => c.Id.ToString()" TextSelector="c => c.Name"
                                          @bind-Value="RecipeCategoryFilterId"
                                          @bind-Value:after="() => OnRecipeCategoryChangedAsync(new ChangeEventArgs { Value = RecipeCategoryFilterId })"
                                          Placeholder="@Resources.RecipesOverview.AllCategoriesOption" />
                            </div>
                        </div>
                    </HeaderContent>
                </GridColumn>
            </Columns>
        </GridTemplate>
    </div>
</div>

<ConfirmDialog @ref="_dialog" />
