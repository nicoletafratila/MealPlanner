@page "/recipebooks/recipepreview"

@if (Recipe != null)
{
    <div class="card">
        <div class="card-header">
            <table>
                <tr class="row g-0 tr-contents">
                    <td class="col-md-8 align-top">
                        <h2>@Recipe.Name</h2>
                    </td>
                    <td class="col-md-3 align-content-end">
                        <a href="@Recipe.Source" target="_blank" class="source-link">
                            <img src="@Recipe.ImageUrl" class="img-fluid" width="100" height="80" />
                        </a>
                    </td>
                </tr>
            </table>
        </div>

        <div class="row">
            <div class="col-5 col-md-4 text-end">@Resources.RecipePreview.RecipeCategory</div>
            <div class="col-7 col-md-8">@RecipeCategory</div>
        </div>

        <div class="col">
            <TableTemplate Data="@Recipe.Ingredients" ShowIndex="true" ColumnCount="4">
                <TableCaption>@Resources.RecipePreview.ListOfIngredients</TableCaption>
                <TableHeader>
                    <th>@Resources.RecipePreview.ColumnName</th>
                    <th>@Resources.RecipePreview.ColumnQuantity</th>
                    <th>@Resources.RecipePreview.ColumnUnit</th>
                    <th>@Resources.RecipePreview.ColumnCategory</th>
                </TableHeader>
                <RowTemplate Context="RecipeIngredient">
                    <td>@RecipeIngredient.Product?.Name</td>
                    <td>@RecipeIngredient.Quantity</td>
                    <td>@RecipeIngredient.Unit?.Name</td>
                    <td>@RecipeIngredient.Product?.ProductCategory?.Name</td>
                </RowTemplate>
            </TableTemplate>
        </div>
    </div>
}

