<style>
    .blazored-modal {
        max-height: fit-content !important;
        max-width: fit-content !important;
        margin-top: 500px !important;
    }
</style>

<div class="modal-body">
    <div class="modal-title">
        <h5>@Resources.RecipeSelection.ModalTitle</h5>
    </div>

    <div class="col">
        <EditForm Model="@this" OnValidSubmit="@SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group mt-3">
                <label for="recipeCategory">@Resources.RecipeSelection.LabelRecipeCategory</label>
                <ComboBox Id="recipeCategory" Items="Categories?.Items" IdSelector="c => c.Id.ToString()" TextSelector="c => c.Name" @bind-Value="RecipeCategoryFilterId" @bind-Value:after="() => OnRecipeCategoryChangedAsync(new ChangeEventArgs { Value = RecipeCategoryFilterId })" Placeholder="@Resources.RecipeSelection.AllCategoriesOption" />
            </div>

            <div class="form-group mt-3">
                <label for="recipeCategory">@Resources.RecipeSelection.LabelRecipe</label>
                <RecipePicker Id="recipe" Recipes="Recipes?.Items" @bind-Value="RecipeId" Placeholder="@Resources.RecipeSelection.ChooseOption" />
            </div>

            <div class="col mt-3">
                <button class="btn btn-primary btn-sm" type="submit">@Resources.RecipeSelection.SaveButton</button>
                <button class="btn btn-danger btn-sm" @onclick="async ()=> await CancelAsync()">@Resources.RecipeSelection.CancelButton</button>
            </div>
        </EditForm>
    </div>
</div>
