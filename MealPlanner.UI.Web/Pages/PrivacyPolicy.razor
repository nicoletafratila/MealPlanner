@page "/privacypolicy"

<style>
    .privacy-content {
        max-width: 720px;
        margin: 2rem auto;
    }

    .privacy-content h5 {
        margin-top: 1.5rem;
    }
</style>

<div class="privacy-content">
    <h3>@Resources.PrivacyPolicy.PageTitle</h3>
    <p><em>@Resources.PrivacyPolicy.LastUpdated</em></p>

    <p>@Resources.PrivacyPolicy.IntroBody</p>

    <h5>@Resources.PrivacyPolicy.DataCollectedHeading</h5>
    <p>@Resources.PrivacyPolicy.DataCollectedBody</p>

    <h5>@Resources.PrivacyPolicy.DataUseHeading</h5>
    <p>@Resources.PrivacyPolicy.DataUseBody</p>

    <h5>@Resources.PrivacyPolicy.DataStorageHeading</h5>
    <p>@Resources.PrivacyPolicy.DataStorageBody</p>

    <h5>@Resources.PrivacyPolicy.DataRetentionHeading</h5>
    <p>@Resources.PrivacyPolicy.DataRetentionBody</p>

    <h5>@Resources.PrivacyPolicy.YourRightsHeading</h5>
    <p>@Resources.PrivacyPolicy.YourRightsBody</p>

    <h5>@Resources.PrivacyPolicy.ChildrenHeading</h5>
    <p>@Resources.PrivacyPolicy.ChildrenBody</p>

    <h5>@Resources.PrivacyPolicy.ChangesHeading</h5>
    <p>@Resources.PrivacyPolicy.ChangesBody</p>

    <h5>@Resources.PrivacyPolicy.ContactHeading</h5>
    <p>@Resources.PrivacyPolicy.ContactBody</p>
</div>
