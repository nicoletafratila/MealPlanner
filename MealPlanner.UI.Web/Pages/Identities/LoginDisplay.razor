<AuthorizeView>
    <Authorized>
        <div class="profile-actions">
            <a href="identities/userprofile/@context.User!.Identity!.Name">
                @Resources.LoginDisplay.Hello
                @if (ApplicationUser != null)
                {
                    <img class="profile-icon me-2" src="@(ApplicationUser!.ProfilePictureUrl ?? "/Images/user.jpg")" />
                }
                @context.User!.Identity!.Name!
            </a>
            <button class="nav-link btn btn-link" @onclick="LogoutAsync">@Resources.LoginDisplay.LogOutButton</button>
        </div>
    </Authorized>
        <NotAuthorized>
            <div class="auth-links">
                <a href="identities/register">@Resources.LoginDisplay.RegisterLink</a>
                <a href="identities/login">@Resources.LoginDisplay.LogInLink</a>
            </div>
        </NotAuthorized>
        <Authorizing>
            @Resources.LoginDisplay.AuthorizingMessage
        </Authorizing>
    </AuthorizeView>