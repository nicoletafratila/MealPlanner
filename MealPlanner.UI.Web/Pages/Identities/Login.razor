@page "/identities/login"

<script>
    window.focusElement = (id) => {
        const el = document.getElementById(id);
        if (el) el.focus();
    };
</script>

<div class="login-background">
    <EditForm Model="LoginModel" OnValidSubmit="OnLoginAsync" class="login-form">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label for="username" class="col-sm-3">@Resources.Login.UsernameLabel</label>
            <InputText id="username" class="form-control" @bind-Value="@LoginModel.Username" placeholder="@Resources.Login.PlaceholderUsername"></InputText>
            <ValidationMessage For="@(() => LoginModel.Username)" />
        </div>

        <div class="form-group mt-3">
            <label for="password" class="col-sm-3">@Resources.Login.PasswordLabel</label>
            <PasswordInput id="password" class="form-control" @onkeydown="HandleKeyDown" @bind-Value="@LoginModel.Password" placeholder="@Resources.Login.PlaceholderPassword"></PasswordInput>
            <ValidationMessage For="@(() => LoginModel.Password)" />
        </div>

        <div class="form-check mt-3">
            <InputCheckbox id="rememberLogin" class="form-check-input" @bind-Value="@LoginModel.RememberLogin"></InputCheckbox>
            <label for="rememberLogin" class="form-check-label">@Resources.Login.RememberMeLabel</label>
        </div>

        <div class="mt-3 d-flex gap-2 align-items-center">
            <button type="submit" class="btn btn-primary btn-sm">@Resources.Login.LoginButton</button>
            <button type="button" class="btn btn-link btn-sm p-0" @onclick="NavigateToForgotPassword">@Resources.Login.ForgotPasswordButton</button>
        </div>
    </EditForm>
</div>
