@page "/mealplans/shopedit"
@page "/mealplans/shopedit/{Id}"
@using MealPlanner.Shared.Models

<Breadcrumb style="--bs-breadcrumb-divider: '>';" Items="_navItems"></Breadcrumb>

@if (Shop != null)
{
    <div class="card">
        <div class="card-header">
            <table>
                <tr class="row g-0" style="display:contents">
                    <td class="col-md-8" style="vertical-align: top">
                        <h2 id="headerName">@Shop.Name</h2>
                    </td>
                </tr>
            </table>
        </div>

        <div class="card-body">
            <EditForm Model="@Shop" OnValidSubmit="@SaveAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-group">
                    <label for="name" class="col-sm-3">@Resources.ShopEdit.LabelShopName</label>
                    <InputText id="name" class="form-control" @bind-Value="@Shop.Name" placeholder="@Resources.ShopEdit.PlaceholderShopName" oninput="updateHeader()"></InputText>
                    <ValidationMessage For="@(() => Shop.Name)" />
                </div>

                <div class="form-group mt-3">
                    <label for="display" class="col-sm-3">@Resources.ShopEdit.LabelDisplayOrder</label>
                </div>

                <div class="card-body">
                    <TableTemplate TItem="ShopDisplaySequenceEditModel" Data="@Shop.DisplaySequence" ShowIndex="true" ColumnCount="2" EnableDragReorder="true" OnReorder="OnReorderAsync">
                        <TableCaption>@Resources.ShopEdit.TableCaptionCategories</TableCaption>
                        <TableHeader>
                            <th>@Resources.ShopEdit.ColumnName</th>
                            <th style="width: 40px"></th>
                        </TableHeader>
                        <RowTemplate Context="DisplaySequence">
                            <td>
                                @DisplaySequence.ProductCategory?.Name
                            </td>
                            <td>
                                <div class="dropdown">
                                    <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="@Resources.ShopEdit.ReorderMenuLabel" @onclick:stopPropagation="true">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li><button class="dropdown-item" type="button" disabled="@(!CanMoveUp(DisplaySequence))" @onclick="async () => await MoveUp(DisplaySequence)">@Resources.ShopEdit.MoveUpAction</button></li>
                                        <li><button class="dropdown-item" type="button" disabled="@(!CanMoveDown(DisplaySequence))" @onclick="async () => await MoveDown(DisplaySequence)">@Resources.ShopEdit.MoveDownAction</button></li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><button class="dropdown-item" type="button" disabled="@(!CanMoveUp(DisplaySequence))" @onclick="async () => await MoveToTop(DisplaySequence)">@Resources.ShopEdit.MoveToTopAction</button></li>
                                        <li><button class="dropdown-item" type="button" disabled="@(!CanMoveDown(DisplaySequence))" @onclick="async () => await MoveToBottom(DisplaySequence)">@Resources.ShopEdit.MoveToBottomAction</button></li>
                                    </ul>
                                </div>
                            </td>
                        </RowTemplate>
                    </TableTemplate>

                    <button class="btn btn-primary btn-sm" type="submit">@Resources.ShopEdit.SaveButton</button>
                    <button class="btn btn-danger btn-sm" type="button" @onclick="async () => await DeleteAsync()">@Resources.ShopEdit.DeleteButton</button>
                    <button class="btn btn-primary btn-sm" type="button" @onclick="NavigateToOverview">@Resources.ShopEdit.BackToOverviewButton</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<ConfirmDialog @ref="_dialog" />

<script>
    function updateHeader() {
        var input = document.getElementById("name").value;
        document.getElementById("headerName").innerText = input;
    }
</script>