<style>
    .blazored-modal {
        max-height: fit-content !important;
        max-width: fit-content !important;
        margin-top: 500px !important; 
    }
</style>

<div class="modal-body">
    <div class="modal-title">
        <h5>@Resources.ShopSelection.Title</h5>
    </div>

    <div class="col">
        <EditForm Model="@this" OnValidSubmit="@SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group mt-3">
                <ShopPicker Id="Shop" Shops="Shops?.Items" SelectedShopId="@ShopId" Placeholder="@Resources.ShopSelection.ChooseOption" OnChanged="OnShopChanged" />
                <ValidationMessage For="@(() => ShopId)" />
            </div>

            <div class="col mt-3">
                <button class="btn btn-primary btn-sm" type="submit">@Resources.ShopSelection.SaveButton</button>
                <button class="btn btn-secondary btn-sm" @onclick="async ()=> await CancelAsync()">@Resources.ShopSelection.CancelButton</button>
            </div>
        </EditForm>
    </div>
</div>
