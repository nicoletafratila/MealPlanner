<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MealPlanner.UI.Mobile.Views.Controls.PasswordEntry"
             x:Name="this">

    <Grid ColumnDefinitions="*,Auto">
        <Entry x:Name="PasswordField"
               Grid.Column="0"
               IsPassword="True"
               Text="{Binding Text, Source={x:Reference this}, Mode=TwoWay}"
               Placeholder="{Binding Placeholder, Source={x:Reference this}}"
               ReturnType="{Binding ReturnType, Source={x:Reference this}}"
               ReturnCommand="{Binding ReturnCommand, Source={x:Reference this}}" />
        <Button x:Name="ToggleButton"
                Grid.Column="1"
                FontSize="18"
                Padding="10,0"
                BackgroundColor="Transparent"
                TextColor="{StaticResource DarkGray}"
                Clicked="OnToggleClicked" />
    </Grid>
</ContentView>
