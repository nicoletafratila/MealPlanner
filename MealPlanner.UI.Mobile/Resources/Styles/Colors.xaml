<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Brand palette — matches MealPlanner.UI.Web's site.css brand tokens (the app's
         own seagreen/orange leafy logo), not the stock MAUI template purple. -->
    <Color x:Key="Primary">#2E8B57</Color>
    <Color x:Key="PrimaryDark">#25714A</Color>
    <Color x:Key="PrimaryLight">#7B5DD4</Color>
    <Color x:Key="Secondary">#DFD8F7</Color>
    <Color x:Key="SecondaryDark">#9880E5</Color>
    <Color x:Key="Tertiary">#2B0B98</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1F1F1F</Color>
    <Color x:Key="LightGray">#F5F5F5</Color>
    <Color x:Key="MidGray">#E0E0E0</Color>
    <Color x:Key="DarkGray">#757575</Color>

    <Color x:Key="PageBackgroundColor">White</Color>
    <Color x:Key="CardBackgroundColor">#F9F9F9</Color>
    <Color x:Key="ErrorColor">#C1432E</Color>
    <Color x:Key="ErrorColorDark">#A73926</Color>
    <Color x:Key="WarningColor">#E08A2C</Color>
    <Color x:Key="WarningColorDark">#C87620</Color>
    <Color x:Key="SuccessColor">#388E3C</Color>

</ResourceDictionary>
