<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Directory.Build.props forces net10.0 for every project except MealPlanner.UI.Mobile.
         The mobile app only targets net10.0-android36.0;net10.0-windows10.0.19041.0, so a plain
         net10.0 test project cannot ProjectReference it. Override to the Windows MAUI TFM so this
         project shares a compatible TFM and runs natively on Windows without an Android emulator. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseMaui>true</UseMaui>
    <OutputType>Library</OutputType>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Without packaging, the WindowsAppSDK module auto-initializer can't find a registered
         Windows App Runtime and crashes tests with COMException "Class not registered".
         Self-contained bundles the runtime so it works in an unpackaged test host. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>MealPlanner.UI.Mobile.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseMaui defaults to the SDK-bundled Microsoft.Maui.Controls version, which is older than
         $(MicrosoftMaui) that MealPlanner.UI.Mobile references — pin explicitly to avoid an
         NU1605 package downgrade error. -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MicrosoftMaui)" />
    <PackageReference Include="coverlet.collector" Version="$(CoverletCollector)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="$(MicrosoftNETTestSdk)" />
    <PackageReference Include="Moq" Version="$(Moq)" />
    <PackageReference Include="NUnit" Version="$(NUnitVersion)" />
    <PackageReference Include="NUnit.Analyzers" Version="$(NUnitAnalyzers)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" Version="$(NUnit3TestAdapter)" />
  </ItemGroup>

  <ItemGroup>
    <!-- MealPlanner.UI.Mobile builds as WindowsPackageType=MSIX (needed for real deployment), which
         bakes in a WindowsAppSDK DeploymentManager module initializer that FailFasts with COMException
         "Class not registered" when the assembly is loaded into this unpackaged test host.
         The primary fix lives in the app project: it disables that initializer in Debug (see the
         WindowsAppSdkDeploymentManagerInitialize=false note in MealPlanner.UI.Mobile.csproj), which
         is what makes Visual Studio Test Explorer work — VS builds the app as its own step and does
         not apply the override below, so it consumes the app's Debug DLL directly.
         The override below additionally neutralizes the initializer when this test project rebuilds
         the app in-process (plain `dotnet test` on the CLI, where BuildProjectReferences defaults to
         true). It reuses the app's normal bin/obj — isolating output paths via AdditionalProperties
         breaks restore (NuGet writes project.assets.json to the default obj; the build then can't
         find it → NETSDK1004), so keep running this project via its own direct invocation rather
         than a default-parallel `dotnet build MealPlanner.sln` (use -m:1 for a solution-wide build). -->
    <ProjectReference Include="..\MealPlanner.UI.Mobile\MealPlanner.UI.Mobile.csproj">
      <AdditionalProperties>WindowsPackageType=None;WindowsAppSdkAutoInitialize=false;WindowsAppSdkDeploymentManagerInitialize=false;WindowsAppSdkBootstrapInitialize=false</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

</Project>
